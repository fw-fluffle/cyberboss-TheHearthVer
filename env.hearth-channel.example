# Hearth Weixin Sidecar (channel-only) — local env template
# Copy values into your private local env / shell. Do NOT commit real tokens.

# observe | echo | bridge | bridge_dry_run
# bridge_dry_run: call real Hearth companion contract, record segments, do not send WeChat, do not set assistant_sent_at
HEARTH_WEIXIN_MODE=bridge_dry_run

# Comma-separated WeChat user ids. Empty = deny all.
HEARTH_WEIXIN_ALLOWED_USER_IDS=

# Preferred full companion URL (local only in v0).
# Example only — replace <port> with your local Gateway port.
HEARTH_COMPANION_URL=http://127.0.0.1:<port>/internal/channel/companion

# Backward-compatible base URL (client appends /internal/channel/companion).
# HEARTH_BRIDGE_URL=http://127.0.0.1:<port>

# Must match The Hearth Gateway HEARTH_INTERNAL_TOKEN. Never commit the real value.
HEARTH_INTERNAL_TOKEN=

# Local HMAC secret for stable account/sender/chat pseudonyms. Never commit the real value.
HEARTH_BRIDGE_PSEUDONYM_SECRET=

# Optional request timeout in milliseconds (default 10000).
HEARTH_REQUEST_TIMEOUT_MS=10000
