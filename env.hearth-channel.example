# ============================================================
# The Hearth 微信 Sidecar（channel-only）本地环境变量模板
# ============================================================
# 用法：把下面的值抄到你自己的本地 .env / 终端环境里。
# 注意：真实 token / 密钥千万别提交进 Git！
# ============================================================

# ------------------------------------------------------------
# 运行模式（四选一）
# ------------------------------------------------------------
# observe        = 只观察消息，不回复
# echo           = 本地回声测试（固定回 "bridge ok"，不打 Hearth）
# bridge         = 打真实 Hearth，并把回复发到微信（会写 delivered）
# bridge_dry_run = 打真实 Hearth，只记录分段回复，不发微信，
#                  也不生成 assistant_sent_at（本轮契约接线推荐）
HEARTH_WEIXIN_MODE=bridge_dry_run

# ------------------------------------------------------------
# 允许对话的微信用户 ID（白名单）
# ------------------------------------------------------------
# 多个 ID 用英文逗号分隔，例如：wxid_aaa,wxid_bbb
# 留空 = 谁都不放行（默认全拒绝，更安全）
HEARTH_WEIXIN_ALLOWED_USER_IDS=

# ------------------------------------------------------------
# Hearth 内部通道地址（推荐写法）
# ------------------------------------------------------------
# 填完整 URL。当前版本只允许本机 http://127.0.0.1 或 localhost。
# 把 <port> 换成你本机 Gateway 的端口，例如 8000。
HEARTH_COMPANION_URL=http://127.0.0.1:<port>/internal/channel/companion

# 兼容旧写法：只填网关根地址也可以。
# 客户端会自动在后面补上 /internal/channel/companion。
# HEARTH_BRIDGE_URL=http://127.0.0.1:<port>

# ------------------------------------------------------------
# 内部鉴权钥匙
# ------------------------------------------------------------
# 必须和 The Hearth 网关里的 HEARTH_INTERNAL_TOKEN 一模一样。
# 这是 Sidecar → 网关的专用钥匙，别拿 Dashboard / 模型 / 微信 token 顶替。
# 真实值只放本地，不要写进仓库。
HEARTH_INTERNAL_TOKEN=

# ------------------------------------------------------------
# 伪名加密盐（给 account / sender / chat 做稳定马赛克）
# ------------------------------------------------------------
# 本地随便设一串足够长的随机字符即可；同一盐值才能得到稳定伪名。
# 真实值不要提交进 Git。
HEARTH_BRIDGE_PSEUDONYM_SECRET=

# ------------------------------------------------------------
# 请求超时（毫秒）
# ------------------------------------------------------------
# 可选。不填时默认 10000（10 秒）。
HEARTH_REQUEST_TIMEOUT_MS=10000

# ------------------------------------------------------------
# Active Line v0：本机主动出站控制面（channel-only 同进程）
# ------------------------------------------------------------
# 只监听 127.0.0.1。默认端口 3200。
# 若 3200 已被占用，Sidecar 启动应明确失败，不会自动改公网地址或随机端口。
HEARTH_WEIXIN_CONTROL_PORT=3200

# 主动发送专用独立密钥（Bearer）。
# 必须与 Dylan 侧 HEARTH_WEIXIN_CONTROL_TOKEN 配置成相同值。
# 严禁复用：HEARTH_INTERNAL_TOKEN / Dashboard admin key / Supabase key / 微信登录 token。
# 真实值只放本地环境，不要提交进 Git。
HEARTH_WEIXIN_CONTROL_TOKEN=

# 说明：
# - POST http://127.0.0.1:<port>/internal/send
# - 共用已登录 adapter、内存 contextTokenCache、持久化 token、default owner 解析
# - request_id 进程内 TTL 去重（默认 15 分钟）；失败后同 id 在 TTL 内仍拒绝，避免双发
# - 进程重启后去重表清空（MVP 可接受）
